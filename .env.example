# ============================================================
# youtube-to-markdown (yt2md) Environment Configuration
# ============================================================

# Groq API Key (Used as fallback for neural Whisper v3 Turbo transcription when native CC is missing)
# Free API key available at: https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here

# Default Output Directory (Optional, overrides ./output)
# YT2MD_OUTPUT_DIR=E:/Ideias/

# Non-interactive mode (Set to 1 to automatically suppress terminal prompts)
# YT2MD_NON_INTERACTIVE=1
